obj-m += tx-isp-t30.o
tx-isp-t30-objs := tx_isp_t30_recovered.o \
	tx_isp_t30_math.o \
	tx_isp_t30_exports.o \
	tx_isp_t30_frame.o \
	tx_isp_t30_io.o \
	tx_isp_t30_videobuf.o \
	tx_isp_t30_sinfo.o \
	tx_isp_t30_subdev.o \
	tx_isp_t30_exposure.o

ifeq ($(CONFIG_VIDEO_V4L2),y)
ifeq ($(CONFIG_DMA_SHARED_BUFFER),y)
tx-isp-t30-objs += tx_isp_t30_v4l2.o
ccflags-y += -DTX_ISP_T30_V4L2
endif
endif

ccflags-y += -DREGTRACE_KERNEL_TREE_BUILD

# Per-frame load statistics (ISR bit counters, work run times), off for
# release builds: make ... TX_ISP_LOAD_STATS=y
ifeq ($(TX_ISP_LOAD_STATS),y)
ccflags-y += -DTX_ISP_LOAD_STATS
endif
# QEMU regression builds only: hold the firmware init window open for this many
# ms (tests/t30/qemu), so a frame IRQ lands before the event queue exists.
ifneq ($(TX_ISP_T30_TEST_FW_INIT_DELAY_MS),)
ccflags-y += -DTX_ISP_T30_TEST_FW_INIT_DELAY_MS=$(TX_ISP_T30_TEST_FW_INIT_DELAY_MS)
endif
ccflags-y += -DTX_ISP_T30_SHARED_SINFO
ccflags-y += -DTX_ISP_T30_SHARED_SUBDEV
ccflags-y += -DTX_ISP_T30_SHARED_MATH
ccflags-y += -DTX_ISP_T30_SHARED_FRAME
ccflags-y += -DTX_ISP_T30_SHARED_IO
ccflags-y += -DTX_ISP_T30_SHARED_VIDEOBUF
ccflags-y += -I$(src)/../include
# Module size (Lu-Fi/openimp#274).  The recovered unit builds at -O0: the lift relies on -O0 memory
# semantics (plain-pointer register polls and write sequences; an -Os build compiled the VIC start
# poll into an endless loop and hung QEMU at stream on, docs/SIZE.md), so it needs a volatile/MMIO
# audit before it can be optimised.  The shared common objects (sinfo, subdev, exposure, region
# allocator, math, io, frame, exports, v4l2) are the same sources the other SoCs build at -Os, so
# they use the kernel's -Os here too.
# TX_ISP_T30_OS=y: recovered unit at -Os as well, every function kept with all its calls (no
# inlining / IPA clones / pure-const-modref call elimination / sibling calls), so
# tests/t30_lift_oracle.sh can hook the same callees as in the vendor ko.  Experimental: oracle ok,
# QEMU tests/t30_qemu ok (lsmod 340 KB), not device-tested, 84 functions still lose memory stores
# at -Os that need a register-access audit (docs/SIZE.md); not for images yet.
TX_ISP_T30_OS ?= n
ifneq ($(TX_ISP_T30_OS),y)
CFLAGS_tx_isp_t30_recovered.o += -O0 -fno-tree-dce -fno-ipa-pure-const -fno-ipa-reference
else
CFLAGS_tx_isp_t30_recovered.o += -fno-inline -fno-inline-small-functions -fno-inline-functions-called-once \
	-fno-partial-inlining -fno-ipa-sra -fno-ipa-cp -fno-ipa-icf -fno-ipa-pure-const \
	-fno-ipa-reference -fno-ipa-ra -fno-optimize-sibling-calls $(call cc-option,-fno-ipa-modref)
endif
# Only the layout changes below; code generation per function is unchanged.
#  - per-function sections + --gc-sections drop functions nothing references
#    (recovered-but-unused helpers); driver/tx_isp_merge.lds KEEPs the
#    module-loader sections and folds the per-function sections back into
#    .text.  No -fdata-sections: the static data layout of the lifted unit
#    stays as it was tested.  TX_ISP_GC=n builds the old layout.
#  - no .pdr (procedure descriptors, never loaded by the kernel)
#  - -x: no local symbols in the .ko (exports resolve through __ksymtab).  Static function names then
#    show only as offsets in oops traces; TX_ISP_T30_KEEPSYMS=y keeps them (.text/.data/.bss identical,
#    file +35 KB, and the module loader keeps that symtab in RAM), for debug builds.
TX_ISP_GC ?= y
ifneq ($(TX_ISP_GC),n)
ccflags-y += -ffunction-sections
LDFLAGS_MODULE += --gc-sections --undefined=init_module --undefined=cleanup_module \
	-T $(abspath $(src)/../tx_isp_merge.lds)
endif
ccflags-y += $(call cc-option,-Wa$(comma)-mno-pdr)
ifneq ($(TX_ISP_T30_KEEPSYMS),y)
LDFLAGS_MODULE += -x
endif
# TX_ISP_T30_WARN=y: lift-defect check (Lu-Fi/openimp#274), use with
# TX_ISP_T30_OS=y; the -Os optimiser sees the uninitialised / out-of-bounds sites.
ifeq ($(TX_ISP_T30_WARN),y)
ccflags-y += -std=gnu99 -Wmaybe-uninitialized -Warray-bounds -Wreturn-type \
	-Wreturn-local-addr -Wframe-larger-than=1024
else
ccflags-y += -std=gnu99 -w
endif
ccflags-y += -Wno-error=strict-prototypes
ccflags-y += -Wno-error=implicit-function-declaration
ccflags-y += -Wno-error=implicit-int
ccflags-y += -Wno-error=int-conversion
ccflags-y += -Wno-error=incompatible-pointer-types
