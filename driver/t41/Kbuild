tx-isp-t41-objs := tx_isp_t41_recovered.o \
		   tx_isp_t41_heapwatch.o \
		   tx_isp_t41_daynight.o \
		   tx_isp_t41_math.o \
		   tx_isp_t41_sinfo.o \
		   tx_isp_t41_subdev.o \
		   tx_isp_t41_frame_layout.o \
		   tx_isp_t41_exposure.o \
		   tx_isp_t41_awb_mesh.o \
		   tx_isp_t41_scaler.o \
		   tx_isp_t41_capture_gate.o \
		   tx_isp_t41_tuning_abi.o \
		   tx_isp_t41_sensor_pin.o \
		   tx_isp_t41_sensor_client.o \
		   tx_isp_t41_procwatch.o \
		   tx_isp_t41_tmo_mxu3.o \
		   tx_isp_t41_rawinject.o
ifneq ($(filter y m,$(CONFIG_VIDEOBUF2_DMA_CONTIG)),)
tx-isp-t41-$(CONFIG_TX_ISP_T41_V4L2) += \
					tx_isp_t41_video_queue.o \
					tx_isp_t41_v4l2.o
ccflags-$(CONFIG_TX_ISP_T41_V4L2) += -DCONFIG_TX_ISP_T41_V4L2
endif
obj-m += tx-isp-t41.o

ccflags-y += -I$(src)/../include
ccflags-y += -DREGTRACE_KERNEL_TREE_BUILD

# Per-frame load statistics (ISR bit counters, work run times), off for
# release builds: make ... TX_ISP_LOAD_STATS=y
ifeq ($(TX_ISP_LOAD_STATS),y)
ccflags-y += -DTX_ISP_LOAD_STATS
endif

# Reproducible builds: the probe log line names the source revision instead of
# __DATE__ (override with OTX_BUILD_ID=..., "unknown" outside a git tree).
OTX_BUILD_ID ?= $(shell git -C $(src) describe --always --dirty --abbrev=12 2>/dev/null || echo unknown)
ccflags-y += -DOTX_BUILD_ID='"$(OTX_BUILD_ID)"'
ccflags-y += -std=gnu99
ccflags-y += -fpermissive
ccflags-y += -w
ccflags-y += -Wno-error=strict-prototypes
ccflags-y += -Wno-error=implicit-function-declaration
ccflags-y += -Wno-error=implicit-int
ccflags-y += -Wno-error=int-conversion
ccflags-y += -Wno-error=incompatible-pointer-types

# Rootfs size: no .pdr (procedure descriptors, never loaded by the kernel).
ccflags-y += $(call cc-option,-Wa$(comma)-mno-pdr)

# Rootfs size: address static data through section anchors (one lui/addiu
# per block instead of a HI16/LO16 pair per object); halves .rel.text.
ccflags-y += -fsection-anchors

# Rootfs size: drop local (static) symbols from the module image. The kernel
# resolves exports through __ksymtab, so .symtab/.strtab bulk is dead weight.
LDFLAGS_MODULE += -x

# TX_ISP_T41_TRACE=y keeps the VIC/VIN/flicker bring-up notes (KERN_WARNING
# progress lines) in the module; the default n compiles them and their strings
# out.  Errors and real warnings always stay.
TX_ISP_T41_TRACE ?= n
ifeq ($(TX_ISP_T41_TRACE),y)
ccflags-y += -DTX_ISP_T41_TRACE
endif

# Rootfs size: per-function sections + --gc-sections drop code (no -fdata-sections:
# it disables -fsection-anchors and doubles .rel.text) that
# nothing references (recovered-but-unused helpers).  driver/tx_isp_merge.lds
# KEEPs the module-loader-only sections (__ksymtab*, .modinfo, __param, ...) and
# folds the sections back into .text/.data/.bss/.rodata.str1.N afterwards, so
# the .ko does not grow thousands of section headers.  Codegen is unchanged
# (section placement only).  TX_ISP_GC=n builds the old layout.
TX_ISP_GC ?= y
ifneq ($(TX_ISP_GC),n)
ccflags-y += -ffunction-sections
LDFLAGS_MODULE += --gc-sections --undefined=init_module --undefined=cleanup_module \
	-T $(abspath $(src)/../tx_isp_merge.lds)
endif

# Bring-up-only module parameters (experiment switches and diagnostic
# counters; list in docs/SIZE.md): y builds them in (needed by
# tools/rawchart/t41_isr_stages.sh and bring-up experiments).  Default n since
# the module-reload heap overwrite is closed (claude/t41-reload: 70+ load/unload
# cycles on .32/.34 without a hit, 5 more with this build); the vendor-compatible
# and documented parameters always stay.
TX_ISP_T41_BRINGUP_PARAMS ?= n
ifeq ($(TX_ISP_T41_BRINGUP_PARAMS),y)
ccflags-y += -DTX_ISP_T41_BRINGUP_PARAMS
endif

# Rootfs size: TX_ISP_T41_TMO_SELFTEST=y builds the t41_tmo_map_selftest
# parameter and its work item (MXU3/fast/reference comparison on random
# input); off by default (host test tx_isp_t41_tmo_map_test covers the maths).
TX_ISP_T41_TMO_SELFTEST ?= n
ifeq ($(TX_ISP_T41_TMO_SELFTEST),y)
ccflags-y += -DTX_ISP_T41_TMO_SELFTEST
endif
