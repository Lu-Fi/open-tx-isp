# Open T32 (PRJ007) TX-ISP driver: sensor registration through the prebuilt
# T32 sensor modules, the libimp 2.2.0 ioctl ABI, VIC/CSI start, MSCA frame
# channels (S2).  tisp/3A and the image pipeline follow in S3 (README.md).
tx-isp-t32-objs := tx_isp_t32_sinfo.o \
		   tx_isp_t32_core.o \
		   tx_isp_t32_funcs.o \
		   tx_isp_t32_hw.o \
		   tx_isp_t32_fs.o
obj-m += tx-isp-t32.o

ccflags-y += -I$(src)/../include -std=gnu99
